{
  "name": "workout-splits",
  "version": "1.3.0",
  "private": true,
  "description": "Science-backed workout split planner: web app, plus Android and iOS apps via Capacitor.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build:web": "node scripts/build-web.mjs",
    "icons": "node scripts/make-icons.mjs",
    "android": "npm run build:web && npx cap sync android && npx cap open android",
    "ios": "npm run build:web && npx cap sync ios && npx cap open ios",
    "vendor": "node scripts/vendor.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/ios": "^8.6.0",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.3"
  },
  "devDependencies": {
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8.6.0",
    "sharp": "^0.35.0",
    "jspdf": "^3.0.4",
    "jspdf-autotable": "^5.0.9"
  }
}
